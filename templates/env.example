# Copy to .env and fill in. Never commit .env.
# Most of these live in n8n credentials rather than a file. This is here for
# self-hosted setups and for keeping track of what you have.

# Telegram
TELEGRAM_BOT_TOKEN=__YOUR_BOT_TOKEN__
TELEGRAM_CHAT_ID=__YOUR_CHAT_ID__

# n8n
N8N_INSTANCE_URL=__YOUR_N8N_URL__
N8N_WEBHOOK_LOG_VIDEO=__WORKFLOW_3_PRODUCTION_WEBHOOK_URL__
N8N_WEBHOOK_HEYGEN_CALLBACK=__WORKFLOW_4_PRODUCTION_WEBHOOK_URL__
N8N_FORM_APPROVAL=__WORKFLOW_2_FORM_URL__

# Claude Code routine
CLAUDE_ROUTINE_TRIGGER_URL=__YOUR_ROUTINE_TRIGGER_URL__
CLAUDE_ROUTINE_TOKEN=__YOUR_ROUTINE_TOKEN__

# HeyGen
# No API key needed. Use the HeyGen MCP connector in Claude.
HEYGEN_AVATAR_ID=__YOUR_AVATAR_ID__
HEYGEN_VOICE_ID=__YOUR_VOICE_ID__

# Google
GOOGLE_SHEET_ID=__YOUR_SPREADSHEET_ID__
GOOGLE_SHEET_NAME=Videos

# YouTube
YOUTUBE_PRIVACY_STATUS=unlisted
