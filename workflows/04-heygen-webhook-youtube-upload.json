        "jsCode": "const items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const fileName = items[i].binary.data.fileName || 'video.mp4';\n  items[i].binary.data = await this.helpers.prepareBinaryData(buffer, fileName, 'video/mp4');\n}\nreturn items;"
