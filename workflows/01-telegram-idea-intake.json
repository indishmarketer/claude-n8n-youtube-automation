    {
      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst chatId = msg.chat.id;\nconst text = (msg.text || '').trim();\nconst lower = text.toLowerCase();\nconst state = $getWorkflowStaticData('global');\n\nconst out = (action, reply, payload) => [{ json: { action, reply: reply || '', payload: payload || '', chatId } }];\n\n// Non-text messages (photos, stickers, etc.) are not handled here\nif (!text) {\n  return out('reply', '🤖 This bot only takes text. Send \"topic\" to start a new video idea, or \"script\" to submit a ready-made script.');\n}\n\n// Cancel resets everything, at any step\nif (['cancel', 'stop', 'reset'].includes(lower)) {\n  state.pending = null;\n  return out('reply', '❌ Cancelled. Nothing was sent to Claude.\\n\\nSend \"topic\" or \"script\" whenever you are ready.');\n}\n\n// Keyword: start topic flow\nif (['topic', 'idea'].includes(lower)) {\n  state.pending = 'topic';\n  return out('reply', '📝 Send me your topic or idea now.\\n\\nYou can include an angle or CTA in the same message if you have one. Add (no vidiq) at the end for personal or opinion content that should not use keyword research.\\n\\nType \"cancel\" to abort.');\n}\n\n// Keyword: start script flow\nif (lower === 'script') {\n  state.pending = 'script';\n  return out('reply', '📜 Send me your final script now, as ONE message.\\n\\n⚠️ It will be treated as ALREADY APPROVED, no review step. Production starts as soon as you send it.\\n\\nType \"cancel\" to abort.');\n}\n\n// Pending: this message IS the topic\nif (state.pending === 'topic') {\n  state.pending = null;\n  return out(\n    'fire',\n    '✅ Got it! Working on:\\n\\n' + text + '\\n\\nYou will get the script here for review once it is ready.',\n    'MODE: new\\nTOPIC: ' + text\n  );\n}\n\n// Pending: this message IS the approved script, fire straight to production\nif (state.pending === 'script') {\n  state.pending = null;\n  return out(\n    'fire',\n    '🎬 Script received and treated as approved.\\n\\nSending it to HeyGen for video production now. You will get a ping here once it is on YouTube.',\n    'MODE: direct\\nSCRIPT:\\n' + text\n  );\n}\n\n// No pending state and not a keyword, guide the user, never fire accidentally\nreturn out('reply', '🤖 What do you want to do?\\n\\n• Send \"topic\" (or \"idea\") → Claude writes a script and sends it for your approval.\\n• Send \"script\" → you paste a ready-made script, it skips approval and goes straight to video production.\\n• Send \"cancel\" anytime to reset.');"
      },
